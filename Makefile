# cloud-serv — Makefile

CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -pthread \
           -DCROW_ENABLE_SSL \
           -Iinclude \
           -Ilibs \
           -MMD -MP

# -lssl -lcrypto: password hashing (PBKDF2), SHA-256, CSPRNG in security/crypto
# -lsqlite3: system SQLite (libsqlite3-dev)
LDFLAGS = -lpthread -lssl -lcrypto -lsqlite3 -lcurl

# Project sources
PROJECT_SOURCES = src/main.cpp \
                  src/core/config.cpp \
                  src/db/database.cpp \
                  src/cli/admin_cli.cpp \
                  src/db/models.cpp \
                  src/http/middleware.cpp \
                  src/routes/admin.cpp \
                  src/routes/auth.cpp \
                  src/routes/files.cpp \
                  src/routes/devices.cpp \
                  src/routes/events.cpp \
                  src/routes/fs.cpp \
                  src/routes/notes.cpp \
                  src/routes/oidc.cpp \
                  src/routes/profile.cpp \
                  src/routes/uploads.cpp \
                  src/routes/static_files.cpp \
                  src/routes/storage.cpp \
                  src/security/crypto.cpp \
                  src/security/e2e_keys.cpp \
                  src/security/oidc.cpp \
                  src/security/request_auth.cpp \
                  src/security/rate_limiter.cpp \
                  src/security/sanitizer.cpp \
                  src/security/tls.cpp \
                  src/storage/file_store.cpp \
                  src/storage/tree_store.cpp \
                  src/storage/tree_scan.cpp \
                  src/storage/tar_extract.cpp \
                  src/utils/logger.cpp \
                  src/utils/string_utils.cpp

# Object files
PROJECT_OBJECTS = $(PROJECT_SOURCES:.cpp=.o)

TARGET = cloud_serv

.PHONY: all clean run

all: $(TARGET)

$(TARGET): $(PROJECT_OBJECTS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $^ $(LDFLAGS)

# Compile C++ sources
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Header dependencies generated by -MMD (per-object .d files). Without this,
# editing a header (e.g. a struct in models.h) would NOT rebuild the .o files
# that include it — leaving object files with mismatched struct layouts.
-include $(PROJECT_OBJECTS:.o=.d)

clean:
	find src -name "*.o" -delete
	find src -name "*.d" -delete
	rm -f $(TARGET)

run: $(TARGET)
	./$(TARGET)
