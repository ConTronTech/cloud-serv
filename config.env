# cloud-serv configuration (.env style — KEY=VALUE)

# Server
PORT=8080
BIND_ADDRESS=0.0.0.0

# Data
DB_PATH=data/cloud.db
STORAGE_DIR=data/storage

# Web client (PWA) — directory served at the site root, same-origin with the API
WEB_DIR=web

# Sessions — how long a login token stays valid (seconds). Default 30 days.
SESSION_SECONDS=2592000

# Trusted proxies (only these direct peers may set X-Forwarded-For).
# Add your reverse proxy / Tailscale ingress IP here when you put one in front.
TRUSTED_PROXIES=127.0.0.1

# Rate limiting (per client IP; requests-per-minute)
# Token bucket: BURST_SIZE = max instantaneous, WRITE_RPM/60 = sustained refill/sec.
# Sized for a personal cloud where uploading many files at once is normal: a
# ~200-file batch fits in the burst, then sustains 10/sec. Every throttled (429)
# request counts toward BAN_THRESHOLD, so that's high — it's a flood safety-net,
# not something a legit bulk upload should hit. The client also paces + retries
# on 429 (see web/app.js).
# NOTE: this one global write limit also covers /api/auth/login. Before exposing
# the server beyond a trusted tailnet, add a separate, stricter auth limit.
RATE_LIMIT_ENABLED=False
READ_RPM=1200
WRITE_RPM=600
BURST_SIZE=200
BAN_THRESHOLD=100
BAN_DURATION=300

# Max request body — one chunk / one direct upload (256 MB). Chunked uploads
# split larger files into pieces below this limit.
MAX_BODY_SIZE=268435456

# Max total size of a single assembled file, in MB (chunked uploads). 5 GB.
MAX_FILE_MB=5120

# CORS — origins allowed for browser clients. Set to your web app's origin.
# Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
