# cloud-serv configuration (.env style — KEY=VALUE)

# Server
PORT=8080
BIND_ADDRESS=0.0.0.0

# Data
DB_PATH=data/cloud.db
STORAGE_DIR=data/storage

# Web client (PWA) — directory served at the site root, same-origin with the API
WEB_DIR=web

# Sessions — how long a login token stays valid (seconds). Default 30 days.
SESSION_SECONDS=2592000

# Trusted proxies (only these direct peers may set X-Forwarded-For).
# Add your reverse proxy / Tailscale ingress IP here when you put one in front.
TRUSTED_PROXIES=127.0.0.1

# Rate limiting (per client IP; requests-per-minute)
RATE_LIMIT_ENABLED=true
READ_RPM=240
WRITE_RPM=60
BURST_SIZE=30
BAN_THRESHOLD=10
BAN_DURATION=600

# Max request body — cloud stores media, so this is large (256 MB).
MAX_BODY_SIZE=268435456

# CORS — origins allowed for browser clients. Set to your web app's origin.
# Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
