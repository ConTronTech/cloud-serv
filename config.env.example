# cloud-serv configuration (.env style — KEY=VALUE)

# Server
PORT=8080
BIND_ADDRESS=0.0.0.0

# Data
DB_PATH=data/cloud.db
STORAGE_DIR=data/storage

# Web client (PWA) — directory served at the site root, same-origin with the API
WEB_DIR=web

# Sessions — how long a login token stays valid (seconds). Default 30 days.
SESSION_SECONDS=2592000

# Trusted proxies (only these direct peers may set X-Forwarded-For).
# Add your reverse proxy / Tailscale ingress IP here when you put one in front.
TRUSTED_PROXIES=127.0.0.1

# Rate limiting (per client IP; requests-per-minute)
# Token bucket: BURST_SIZE = max instantaneous, WRITE_RPM/60 = sustained refill/sec.
# Sized for a personal cloud where uploading many files at once is normal: a
# ~200-file batch fits in the burst, then sustains 10/sec. Every throttled (429)
# request counts toward BAN_THRESHOLD, so that's high — it's a flood safety-net,
# not something a legit bulk upload should hit. The client also paces + retries
# on 429 (see web/app.js).
# NOTE: this one global write limit also covers /api/auth/login. Before exposing
# the server beyond a trusted tailnet, add a separate, stricter auth limit.
RATE_LIMIT_ENABLED=False
READ_RPM=1200
WRITE_RPM=600
BURST_SIZE=200
BAN_THRESHOLD=100
BAN_DURATION=300

# Max request body — one chunk / one direct upload (256 MB). Chunked uploads
# split larger files into pieces below this limit.
MAX_BODY_SIZE=268435456

# Max total size of a single assembled file, in MB (chunked uploads). 5 GB.
MAX_FILE_MB=5120

# CORS — origins allowed for browser clients. Set to your web app's origin.
# Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# TLS — cloud-serv terminates its own HTTPS (self-signed EC P-256, 10y). No reverse proxy.
# TLS_ENABLED=false serves plain HTTP (local dev only).
# At startup the cert is (re)generated if missing OR if its SAN doesn't include this
# box's Tailscale IP (detected via `tailscale ip -4`, else a 100.64.0.0/10 interface).
# So setting up Tailscale after the cert exists is picked up automatically on next launch.
# The key is chmod 0600 and its directory 0700. A self-signed cert (the fallback) still needs
# to be trusted/accepted once by browsers, and service workers / Android PWA install may not work.
TLS_ENABLED=true
TLS_CERT_PATH=data/tls/server.crt
TLS_KEY_PATH=data/tls/server.key
# Prefer a real, browser-trusted Tailscale-issued cert: at startup runs `tailscale status --json`
# (MagicDNS name) then `tailscale cert` for that name. Makes service workers and Android PWA
# install work without a warning. Falls back to the self-signed generator if Tailscale is
# missing/logged out/MagicDNS is off or the command fails (the fallback keeps the trust caveat).
# An existing cert is preserved if it parses, is not within 24h of expiry, and either covers the
# Tailscale IP or is not self-signed.
TLS_PREFER_TAILSCALE_CERT=true

# Self-registration invite code. POST /api/auth/register must carry this as "inviteCode".
# Empty = registration disabled entirely (the safe default): a wrong code, a taken email and
# a disabled server all return the same generic 403, so registration can't be used to
# enumerate accounts. Set a long random string to open registration to people you invite.
# You must set this to create ANY account, including the very first bootstrap one.
REGISTRATION_INVITE_CODE=

# Roles & storage quotas — the account with the lowest id is auto-promoted to
# "admin" on startup if no admin exists yet (so your first registration becomes
# the admin with zero manual steps). An admin manages OTHER accounts' role,
# suspension and quota via GET/PATCH /api/admin/users. The API has no route to
# read anyone's files or folders (end-to-end encrypted; the server holds no key).
# NOTE: notes are NOT end-to-end encrypted — see docs/ADMIN_API.md.
#
# Default storage quota (GB) newly-registered accounts start with. 0 = unlimited
# (the default). An admin can change any individual account's quota afterwards.
DEFAULT_STORAGE_QUOTA_GB=0

# Where the admin "remove" action puts its backups: one <userid>_<utc>/ folder per
# removed account (data.json = that account's rows, storage/ = its still-encrypted
# blobs). Owner-only (0700/0600). Only an admin "wipe" of the removed account deletes it.
BACKUP_DIR=data/backups
